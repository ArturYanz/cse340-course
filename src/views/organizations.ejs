
<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <p>Here are a few of our partner organizations:</p>
        <ul class="image-list">
            <% organizations.forEach(organizations => { %>
                <li>
                    <img class="item-logo" src="/images/<%= organizations.logo_filename %>" alt="<%= organizations.name %> logo">
                    <strong><%= organizations.name %></strong><%= organizations.contact_email %>
                </li>
            <% }) %>
            
            
    </main>
<%- include('partials/footer') %>