<%- include('partials/header') %>
<main>
    <h1>
        <%= title %>
    </h1>
    <ul class="image-list">
        <% categories.forEach(category=> { %>
            <li>
                <img class="item-logo" src="/images/<%= category.image_filename %>"
                    alt="<%= category.name %> category logo">
                <a href="/category/<%= category.category_id %>">
                    <strong>
                        <%= category.name %>
                    </strong>
                </a>
            </li>
            <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>