<% include('partials/header') %>

<main>
    <h2><%= organizationDetails.name %></h2>


    <img src="/images/<%= organizationDetails.logo_filename %>" alt="Logo of <%= organizationDetails.name %>">

    <p><%= organizationDetails.description %></p>

    <h3>Service Projects</h3>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>